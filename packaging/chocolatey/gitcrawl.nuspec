<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2015/06/nuspec.xsd">
  <metadata>
    <id>gitcrawl</id>
    <version>1.0.0</version>
    <title>gitcrawl</title>
    <authors>Ricardo Veronese Ricci</authors>
    <projectUrl>https://github.com/riccivr/gitcrawl</projectUrl>
    <licenseUrl>https://github.com/riccivr/gitcrawl/blob/master/LICENSE</licenseUrl>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <description>Git-native content-addressable web archival engine and crawler in clean C99.</description>
    <tags>git crawler archive markdown diff web scraping cli</tags>
  </metadata>
  <files>
    <file src="tools\**" target="tools" />
  </files>
</package>
